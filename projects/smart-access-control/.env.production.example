# Copy to `.env.production` (git-ignored) and fill in every empty value.
# Used by docker-compose.prod.yml; see README "Deployment".

# Public host name. Caddy obtains a certificate for it automatically (ports
# 80 and 443 must be reachable). `localhost` uses Caddy's own local CA.
SITE_ADDRESS=access.example.com
# Seconds browsers remember "HTTPS only". Use 0 when trying on localhost.
HSTS_MAX_AGE=31536000
# Host ports for the proxy.
HTTP_PORT=80
HTTPS_PORT=443
# The proxy's network, and its fixed address in it (the only address the app
# trusts to report client IPs). Change if the subnet overlaps another Docker
# network (`docker network inspect`).
PROXY_SUBNET=10.83.83.0/24
PROXY_IP=10.83.83.10

POSTGRES_USER=sac
# Hex only (it is embedded in a connection URL): openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=smart_access_control

# openssl rand -hex 32
JWT_SECRET=
# Optional; enables /metrics on the internal network: openssl rand -hex 16
METRICS_TOKEN=

# Keep false in production.
SIMULATOR_ENABLED=false
