# Copy to `.env` and adjust. `.env` is git-ignored; never commit real secrets.

# --- API server ---
APP_HOST=127.0.0.1
APP_PORT=8080
RUST_LOG=smart_access_control=debug,tower_http=debug
# `pretty` (default, for terminals) or `json` (one object per line, for log
# collectors). Every request's lines carry its `request_id`.
LOG_FORMAT=pretty
# Enables GET /metrics (Prometheus format) for scrapers presenting
# `Authorization: Bearer <token>`. Unset = no metrics endpoint. At least 16
# bytes, e.g. `openssl rand -hex 16`.
METRICS_TOKEN=
# Reverse proxies (IPs or CIDRs, comma-separated) allowed to report the
# client address in X-Forwarded-For. Empty = use the TCP peer address.
TRUSTED_PROXIES=
# Serve the built dashboard (`npm run build` in dashboard/) at `/`, e.g.
# dashboard/dist. Unset in development, where Vite serves it.
STATIC_DIR=
# Browser origins allowed to call the API, comma-separated (e.g. the dashboard
# dev server: http://localhost:5173). Empty = same-origin only.
CORS_ALLOWED_ORIGINS=

# --- Door controllers (simulated) ---
# A controller that sends no heartbeat for this long is marked offline,
# together with its doors.
CONTROLLER_TIMEOUT_SECONDS=30
# Run simulated controllers in-process and expose /api/v1/simulator/*
# (admin only). Development and demos; keep false in production.
SIMULATOR_ENABLED=true
# Concurrent live-event WebSocket connections.
WS_MAX_CONNECTIONS=256

# --- PostgreSQL (docker compose) ---
POSTGRES_USER=sac
POSTGRES_PASSWORD=change-me
POSTGRES_DB=smart_access_control
POSTGRES_PORT=55432

# --- Application database ---
DATABASE_URL=postgres://sac:change-me@127.0.0.1:55432/smart_access_control
DATABASE_MAX_CONNECTIONS=10

# --- Authentication ---
# Signs access tokens. Required, at least 32 bytes. Generate your own:
#   openssl rand -hex 32
JWT_SECRET=replace-me-with-the-output-of-openssl-rand-hex-32
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
# `Secure` flag on the refresh-token cookie. Browsers accept Secure cookies on
# http://localhost; set false only to serve the dashboard over plain HTTP
# from another host.
COOKIE_SECURE=true

# --- Tests ---
# Server used by integration tests to create throwaway `sac_test_*` databases.
# Must be a local server; the test harness refuses any other host.
TEST_DATABASE_URL=postgres://sac:change-me@127.0.0.1:55432/postgres
